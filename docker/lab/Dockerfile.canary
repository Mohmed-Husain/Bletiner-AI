# Leak detector (docs/16 R-22). The gateway's upstream default route points here. Any packet the gateway
# forwards to an off-lab destination lands on this container and is captured. A passing negative test needs
# BOTH a client-side failure AND zero captured packets for that destination.
FROM alpine:3.19
RUN apk add --no-cache tcpdump python3
# A sink that accepts any TCP connection, so a "leak" completes a handshake and is unmistakable in the pcap.
COPY docker/lab/canary_sink.py /canary_sink.py
CMD ["sh", "-c", "python3 /canary_sink.py & tcpdump -nni any -w /captures/leak.pcap 2>/dev/null"]
